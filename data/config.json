{
  "coverage": [
    "Premier League",
    "La Liga",
    "Serie A",
    "Bundesliga",
    "Ligue 1",
    "UEFA Champions League",
    "UEFA Europa League",
    "EFL/Carabao Cup",
    "FA Cup"
  ],
  "rules": {
    "A": "0.5–0.75u",
    "B": "0.25–0.5u; 2-leg Core Parlay; each leg Market >=55%, prefer 65–82%; My Fair >= Market +3pp; combo My Fair >=40%; different matches, low correlation; exclude unresolved rotation/motivation/lineup shocks",
    "C": "2.5x–4x; ≤0.25u",
    "match_cap": "≤1u"
  },
  "data_engine": {
    "mode": "paper_and_approval",
    "min_edge_pp": 0.04,
    "min_ev": 0.05,
    "min_liquidity_usd": 100,
    "max_match_exposure_units": 1,
    "auto_real_money_execution": false,
    "kalshi_base_url": "https://external-api.kalshi.com/trade-api/v2",
    "sportsbook": {
      "provider": "the_odds_api_v4",
      "regions": "us,uk,eu",
      "markets": "h2h,spreads,totals",
      "consensus_method": "median_de_vig_probability",
      "max_model_consensus_gap_for_auto_ready": 0.12,
      "api_key_env": "ODDS_API_KEY"
    },
    "football_intelligence": {
      "provider": "football-data.org v4",
      "api_key_env": "FOOTBALL_DATA_API_KEY",
      "competition_codes": {
        "Premier League": "PL",
        "La Liga": "PD",
        "Serie A": "SA",
        "Bundesliga": "BL1",
        "Ligue 1": "FL1",
        "UEFA Champions League": "CL"
      },
      "lookback_days": 180,
      "recent_half_life_days": 60,
      "model": "Poisson goal model + transparent log-lambda adjustments",
      "market_consensus_in_my_fair": false
    },
    "fair_model": {
      "max_goals": 8,
      "home_advantage_log": 0.12,
      "shrinkage_matches": 8,
      "rotation_depth_resilience": 0.65,
      "adjustment_caps_log_lambda": {
        "recent_form": 0.12,
        "lineup": 0.18,
        "tier_gap": 0.16,
        "squad_depth": 0.12,
        "injuries": 0.15,
        "rest": 0.08,
        "tactical": 0.1,
        "motivation": 0.06,
        "weather": 0.04
      },
      "note": "Initial priors, not calibrated production coefficients. Cup rotation is evaluated relative to opponent quality: negative lineup penalties may be softened by a pre-match depth-mismatch score, while tier_gap and squad_depth are explicit bounded terms. Backtest and recalibrate; do not fit coefficients from one result."
    },
    "backtest": {
      "version": "v0.3.5",
      "train_fraction": 0.7,
      "activation_min_holdout_predictions": 500,
      "fit_metric": "multiclass_log_loss",
      "report_metrics": [
        "multiclass_log_loss",
        "multiclass_brier",
        "accuracy",
        "calibration"
      ],
      "grid": {
        "recent_half_life_days": [
          30,
          60,
          90,
          120
        ],
        "shrinkage_matches": [
          4,
          8,
          12,
          16
        ],
        "home_advantage_log": [
          0.04,
          0.08,
          0.12,
          0.16
        ]
      },
      "no_lookahead": true
    },
    "point_in_time": {
      "version": "v0.3.4",
      "snapshot_frequency": "hourly",
      "immutable_daily_archives": true,
      "horizon_buckets_minutes": {
        "CLOSE": [
          0,
          45
        ],
        "T-1H": [
          45,
          120
        ],
        "T-6H": [
          120,
          540
        ],
        "T-24H": [
          540,
          2160
        ],
        "EARLY": [
          2160,
          null
        ]
      },
      "fields": [
        "my_fair",
        "sportsbook_probability",
        "kalshi_probability",
        "kalshi_liquidity_usd",
        "kickoff_utc",
        "model_status",
        "football_intelligence_status"
      ]
    },
    "clv": {
      "version": "v0.3.4",
      "yes_side_definition": "closing_probability - entry_probability",
      "preferred_close_reference": "kalshi",
      "fallback_close_reference": "sportsbook_consensus",
      "retroactive_imputation": false
    },
    "core_parlay": {
      "version": "v0.3.7",
      "philosophy": "probability_first_then_ev",
      "leg_market_probability_min": 0.55,
      "preferred_market_probability_range": [
        0.65,
        0.82
      ],
      "leg_fair_probability_min": 0.58,
      "min_model_edge_pp": 0.03,
      "combo_fair_probability_min": 0.4,
      "legs": 2,
      "require_different_matches": true,
      "prefer_low_correlation": true,
      "prefer_different_competitions": true,
      "hard_exclusions": [
        "rotation uncertainty",
        "motivation uncertainty",
        "lineup shock"
      ],
      "note": "B-class Core Parlay: each leg must have Market Probability >=55% and My Fair >= Market +3pp; 65%-82% Market Probability is preferred, not mandatory. Two-leg combo My Fair must be >=40%. Use different matches and prefer low correlation. Exclude any leg with unresolved rotation uncertainty, motivation uncertainty, or lineup shock. High market probability alone is not alpha."
    }
  }
}
