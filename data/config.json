{
  "coverage": [
    "Premier League",
    "La Liga",
    "Serie A",
    "Bundesliga",
    "Ligue 1",
    "UEFA Champions League",
    "EFL/Carabao Cup",
    "FA Cup"
  ],
  "rules": {
    "A": "0.5–0.75u",
    "B": "0.25–0.5u; different leagues",
    "C": "2.5x–4x; ≤0.25u",
    "match_cap": "≤1u"
  },
  "data_engine": {
    "mode": "paper_and_approval",
    "min_edge_pp": 0.04,
    "min_ev": 0.05,
    "min_liquidity_usd": 100,
    "max_match_exposure_units": 1,
    "auto_real_money_execution": false,
    "kalshi_base_url": "https://external-api.kalshi.com/trade-api/v2",
    "sportsbook": {
      "provider": "the_odds_api_v4",
      "regions": "us,uk,eu",
      "markets": "h2h,spreads,totals",
      "consensus_method": "median_de_vig_probability",
      "max_model_consensus_gap_for_auto_ready": 0.12,
      "api_key_env": "ODDS_API_KEY"
    },
    "football_intelligence": {
      "provider": "football-data.org v4",
      "api_key_env": "FOOTBALL_DATA_API_KEY",
      "competition_codes": {
        "Premier League": "PL",
        "La Liga": "PD",
        "Serie A": "SA",
        "Bundesliga": "BL1",
        "Ligue 1": "FL1",
        "UEFA Champions League": "CL"
      },
      "lookback_days": 180,
      "recent_half_life_days": 60,
      "model": "Poisson goal model + transparent log-lambda adjustments",
      "market_consensus_in_my_fair": false
    },
    "fair_model": {
      "max_goals": 8,
      "home_advantage_log": 0.12,
      "shrinkage_matches": 8,
      "adjustment_caps_log_lambda": {
        "recent_form": 0.12,
        "lineup": 0.18,
        "injuries": 0.15,
        "rest": 0.08,
        "tactical": 0.1,
        "motivation": 0.06,
        "weather": 0.04
      },
      "note": "Initial priors, not calibrated production coefficients. Backtest and recalibrate."
    },
    "backtest": {
      "version": "v0.3.3",
      "train_fraction": 0.7,
      "activation_min_holdout_predictions": 500,
      "fit_metric": "multiclass_log_loss",
      "report_metrics": [
        "multiclass_log_loss",
        "multiclass_brier",
        "accuracy",
        "calibration"
      ],
      "grid": {
        "recent_half_life_days": [
          30,
          60,
          90,
          120
        ],
        "shrinkage_matches": [
          4,
          8,
          12,
          16
        ],
        "home_advantage_log": [
          0.04,
          0.08,
          0.12,
          0.16
        ]
      },
      "no_lookahead": true
    }
  }
}